# name: test/sql/integration/httpfs/secrets/persistent_key_value_secret.test
# group: [secrets]

load __TEST_DIR__/persistent_extra_headers

require duckdb_opendalfs

require json

statement ok
CREATE PERSISTENT SECRET http (
	TYPE HTTP,
	EXTRA_HTTP_HEADERS MAP {
		'Authorization': 'Bearer sk_test_not_valid_key'
	}
);

restart

# Persistent HTTP headers must survive restart. The invalid endpoint must fail
# through OpenDAL's stat operation without relying on HTTPFS-specific error text.
statement error
select
	unnest(data) as customers
from
	read_json('https://non.existant/endpoint');
----
<REGEX>:.*stat.*https://non[.]existant/endpoint.*
